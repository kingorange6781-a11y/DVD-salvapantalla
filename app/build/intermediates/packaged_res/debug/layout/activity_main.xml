<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#071a2a">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VibeSaver"
            android:textColor="#F2F7FF"
            android:textSize="38sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/darknessValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Oscurecer: 80%"
            android:textColor="#DDEAFB"
            android:textSize="22sp"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/darknessBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="80"
            android:progress="80"
            android:progressTint="#67E8F9"
            android:thumbTint="#A5F3FC"
            android:layout_marginBottom="18dp" />

        <TextView
            android:id="@+id/sizeValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tamaño: 1.00x"
            android:textColor="#DDEAFB"
            android:textSize="22sp"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/sizeBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="60"
            android:progressTint="#7DD3FC"
            android:thumbTint="#BAE6FD"
            android:layout_marginBottom="18dp" />

        <TextView
            android:id="@+id/speedValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Velocidad: 1.00x"
            android:textColor="#DDEAFB"
            android:textSize="22sp"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/speedBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50"
            android:progressTint="#67E8F9"
            android:thumbTint="#A5F3FC"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/startDreamButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="INICIAR SALVAPANTALLAS"
            android:textSize="20sp"
            android:textAllCaps="true"
            android:background="#4B5563"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/orientationButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="ORIENTACIÓN: LANDSCAPE"
            android:textSize="18sp"
            android:textAllCaps="true"
            android:background="#2D3A4F"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/openSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="AJUSTES DE PANTALLA"
            android:textSize="18sp"
            android:textAllCaps="true"
            android:background="#374151"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/remapButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="PERMISOS DE REMAPEO"
            android:textSize="18sp"
            android:textAllCaps="true"
            android:background="#1F2937"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
